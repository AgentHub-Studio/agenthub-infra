# ============================================================
# TEMPLATE — copie para secrets.yaml e preencha os valores
# NÃO versione o secrets.yaml real (está no .gitignore)
#
# Para criar via kubectl:
#   kubectl apply -f k8s/secrets.yaml
#
# Os serviços Go usam chaves em kebab-case (database-url, rabbitmq-url, ...).
# Os serviços Java legados usam UPPER_SNAKE (mantidos para rollback).
# ============================================================
---
apiVersion: v1
kind: Secret
metadata:
  name: agenthub-secrets
  namespace: agenthub
type: Opaque
stringData:
  # ── Serviços Go (connection strings completas) ───────────────────────────────
  # Formato: postgres://user:password@host:port/dbname?sslmode=disable
  database-url: "postgres://agenthub:CHANGE_ME@postgres.agenthub.svc.cluster.local:5432/agenthub?sslmode=disable"
  # Formato: amqp://user:password@host:port/
  rabbitmq-url: "amqp://agenthub:CHANGE_ME@rabbitmq.agenthub.svc.cluster.local:5672/"
  # Formato: clickhouse://user:password@host:9000/default
  clickhouse-dsn: "clickhouse://default:CHANGE_ME@clickhouse.agenthub.svc.cluster.local:9000/default"
  # MinIO credentials
  minio-access-key: "minioadmin"
  minio-secret-key: "CHANGE_ME"

  # ── LLM API Keys (opcionais — apenas adicione os providers em uso) ───────────
  # openai-api-key: "sk-CHANGE_ME"
  # anthropic-api-key: "sk-ant-CHANGE_ME"
  # openrouter-api-key: "sk-or-CHANGE_ME"
  # (Ollama não precisa de API key — configure ollama-base-url no ConfigMap)

  # ── Serviços Java legados (manter para rollback) ─────────────────────────────
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: CHANGE_ME
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: CHANGE_ME
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: CHANGE_ME
  RABBITMQ_USER: agenthub
  RABBITMQ_PASSWORD: CHANGE_ME
