{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Comparação de métricas Java vs Go durante cutover — fase-5",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Latência por Serviço",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"agenthub-api\",version=\"java\"}[5m])) by (le)) * 1000",
          "legendFormat": "API Java P95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"agenthub-api\",version=\"go\"}[5m])) by (le)) * 1000",
          "legendFormat": "API Go P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"agenthub-api\",version=\"go\"}[5m])) by (le)) * 1000",
          "legendFormat": "API Go P50"
        }
      ],
      "title": "agenthub-api — Latência P50/P95 (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"agenthub-orchestrator\",version=\"java\"}[5m])) by (le)) * 1000",
          "legendFormat": "Orchestrator Java P95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"agenthub-orchestrator\",version=\"go\"}[5m])) by (le)) * 1000",
          "legendFormat": "Orchestrator Go P95"
        }
      ],
      "title": "agenthub-orchestrator — Latência P95 (ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Taxa de Erros",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{version=\"java\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{version=\"java\"}[5m]))",
          "legendFormat": "Java Error Rate"
        },
        {
          "expr": "sum(rate(http_requests_total{version=\"go\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{version=\"go\"}[5m]))",
          "legendFormat": "Go Error Rate"
        }
      ],
      "title": "Taxa de Erros 5xx (Java vs Go)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{version=\"java\"}[5m]))",
          "legendFormat": "Java req/s"
        },
        {
          "expr": "sum(rate(http_requests_total{version=\"go\"}[5m]))",
          "legendFormat": "Go req/s"
        }
      ],
      "title": "Throughput (req/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Recursos (Memory / CPU)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 134217728 },
              { "color": "red", "value": 268435456 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"agenthub\",container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "Memory por Pod (Java vs Go)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"agenthub\",container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}} CPU"
        }
      ],
      "title": "CPU por Pod",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Observability — Ingestão de Eventos",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "targets": [
        {
          "expr": "rate(execution_events_consumed_total{version=\"go\"}[5m])",
          "legendFormat": "Go eventos/s"
        },
        {
          "expr": "rate(execution_events_consumed_total{version=\"java\"}[5m])",
          "legendFormat": "Java eventos/s"
        }
      ],
      "title": "Taxa de Ingestão de Eventos (RabbitMQ)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "targets": [
        {
          "expr": "rate(clickhouse_writes_total{version=\"go\"}[5m])",
          "legendFormat": "Go writes/s"
        }
      ],
      "title": "Taxa de Writes no ClickHouse",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["agenthub", "cutover", "migration"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgentHub — Cutover Java → Go",
  "uid": "cutover-comparison",
  "version": 1
}
