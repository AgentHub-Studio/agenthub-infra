# AgentHub Infrastructure Environment Variables
# Copy this file to .env and adjust values as needed

# =============================================================================
# GENERAL
# =============================================================================
COMPOSE_PROJECT_NAME=agenthub
DOCKER_NETWORK=agenthub-shared-net

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_HOST=agenthub-postgresql
POSTGRES_PORT=5432
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=changeme_secure_password

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_admin_password
KEYCLOAK_DB_HOST=agenthub-postgresql
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme_keycloak_password
KEYCLOAK_FRONTEND_URL=http://localhost:8080

# =============================================================================
# MINIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# =============================================================================
# RABBITMQ
# =============================================================================
RABBITMQ_DEFAULT_USER=agenthub
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PORT=5672

# =============================================================================
# OLLAMA (LLM Runtime)
# =============================================================================
OLLAMA_HOST=agenthub-ollama
OLLAMA_PORT=11434

# =============================================================================
# BACKEND (Java/Spring Boot)
# =============================================================================
BACKEND_PORT=8081
BACKEND_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
BACKEND_DB_USERNAME=agenthub
BACKEND_DB_PASSWORD=changeme_secure_password
BACKEND_KEYCLOAK_URL=http://agenthub-keycloak:8080
BACKEND_KEYCLOAK_REALM=agenthub
BACKEND_KEYCLOAK_CLIENT_ID=agenthub-backend
BACKEND_KEYCLOAK_CLIENT_SECRET=changeme_client_secret
BACKEND_MINIO_URL=http://agenthub-minio:9000
BACKEND_MINIO_ACCESS_KEY=minioadmin
BACKEND_MINIO_SECRET_KEY=changeme_minio_password
BACKEND_RABBITMQ_HOST=agenthub-rabbitmq
BACKEND_RABBITMQ_PORT=5672
BACKEND_RABBITMQ_USERNAME=agenthub
BACKEND_RABBITMQ_PASSWORD=changeme_rabbitmq_password

# =============================================================================
# FRONTEND (Angular)
# =============================================================================
FRONTEND_PORT=4200
FRONTEND_API_URL=http://localhost:8081

# =============================================================================
# ORCHESTRATOR (Java)
# =============================================================================
ORCHESTRATOR_PORT=8082
ORCHESTRATOR_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
ORCHESTRATOR_DB_USERNAME=agenthub
ORCHESTRATOR_DB_PASSWORD=changeme_secure_password
ORCHESTRATOR_RABBITMQ_HOST=agenthub-rabbitmq
ORCHESTRATOR_RABBITMQ_PORT=5672
ORCHESTRATOR_RABBITMQ_USERNAME=agenthub
ORCHESTRATOR_RABBITMQ_PASSWORD=changeme_rabbitmq_password

# =============================================================================
# SKILL RUNTIME (Java)
# =============================================================================
SKILL_RUNTIME_PORT=8083
SKILL_RUNTIME_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
SKILL_RUNTIME_DB_USERNAME=agenthub
SKILL_RUNTIME_DB_PASSWORD=changeme_secure_password
SKILL_RUNTIME_MCP_CLIENT_URL=http://agenthub-mcp-client-runtime:8090
SKILL_RUNTIME_OLLAMA_URL=http://agenthub-ollama:11434

# =============================================================================
# PACKAGE REGISTRY (Java)
# =============================================================================
PACKAGE_REGISTRY_PORT=8084
PACKAGE_REGISTRY_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
PACKAGE_REGISTRY_DB_USERNAME=agenthub
PACKAGE_REGISTRY_DB_PASSWORD=changeme_secure_password
PACKAGE_REGISTRY_MINIO_URL=http://agenthub-minio:9000
PACKAGE_REGISTRY_MINIO_ACCESS_KEY=minioadmin
PACKAGE_REGISTRY_MINIO_SECRET_KEY=changeme_minio_password

# =============================================================================
# MARKETPLACE (Java)
# =============================================================================
MARKETPLACE_PORT=8085
MARKETPLACE_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
MARKETPLACE_DB_USERNAME=agenthub
MARKETPLACE_DB_PASSWORD=changeme_secure_password

# =============================================================================
# OBSERVABILITY (Java)
# =============================================================================
OBSERVABILITY_PORT=8086
OBSERVABILITY_DB_URL=jdbc:postgresql://agenthub-postgresql:5432/agenthub
OBSERVABILITY_DB_USERNAME=agenthub
OBSERVABILITY_DB_PASSWORD=changeme_secure_password

# =============================================================================
# MCP CLIENT RUNTIME (Go)
# =============================================================================
MCP_CLIENT_RUNTIME_PORT=8090
MCP_CLIENT_RUNTIME_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub

# =============================================================================
# MCP SERVER RUNTIME (Go)
# =============================================================================
MCP_SERVER_RUNTIME_PORT=8091
MCP_SERVER_RUNTIME_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub

# =============================================================================
# EMBEDDING SERVICE (Go)
# =============================================================================
EMBEDDING_PORT=8092
EMBEDDING_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub
EMBEDDING_OLLAMA_URL=http://agenthub-ollama:11434

# =============================================================================
# EMBEDDING JOB (Go)
# =============================================================================
EMBEDDING_JOB_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub
EMBEDDING_JOB_OLLAMA_URL=http://agenthub-ollama:11434
EMBEDDING_JOB_EMBEDDING_SERVICE_URL=http://agenthub-embedding:8092

# =============================================================================
# EXTRACTOR (Go)
# =============================================================================
EXTRACTOR_PORT=8093
EXTRACTOR_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub
EXTRACTOR_MINIO_URL=http://agenthub-minio:9000
EXTRACTOR_MINIO_ACCESS_KEY=minioadmin
EXTRACTOR_MINIO_SECRET_KEY=changeme_minio_password

# =============================================================================
# GRAPH GENERATOR (Go)
# =============================================================================
GRAPH_GENERATOR_PORT=8094
GRAPH_GENERATOR_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub
GRAPH_GENERATOR_OLLAMA_URL=http://agenthub-ollama:11434

# =============================================================================
# VPN PROXY (Go)
# =============================================================================
VPN_PROXY_PORT=8095
VPN_PROXY_DB_URL=postgresql://agenthub:changeme_secure_password@agenthub-postgresql:5432/agenthub

# =============================================================================
# NGINX
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# CLOUDFLARE
# =============================================================================
CLOUDFLARE_API_TOKEN=changeme_cloudflare_token
CLOUDFLARE_ZONE_ID=changeme_zone_id
CLOUDFLARE_TUNNEL_TOKEN=changeme_tunnel_token
