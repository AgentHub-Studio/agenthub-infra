#!/bin/bash

# AgentHub Infrastructure - Stop Services
# Usage: ./scripts/stop [profile]
# If no profile specified, stops all services

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

PROFILE="${1:-}"

cd "$PROJECT_ROOT"

if [ -z "$PROFILE" ]; then
    echo -e "${BLUE}Stopping all AgentHub services...${NC}"
    docker compose --profile minimal --profile backend --profile full --profile edge down
else
    # Validate profile
    case "$PROFILE" in
        minimal|backend|full|edge)
            echo -e "${BLUE}Stopping AgentHub services with profile: ${PROFILE}${NC}"
            docker compose --profile "$PROFILE" down
            ;;
        *)
            echo -e "${RED}Error: Invalid profile '${PROFILE}'${NC}"
            echo ""
            echo "Usage: $0 [profile]"
            echo ""
            echo "Available profiles: minimal, backend, full, edge"
            echo "Or omit profile to stop all services"
            echo ""
            exit 1
            ;;
    esac
fi

echo ""
echo -e "${GREEN}Services stopped successfully!${NC}"
echo ""
