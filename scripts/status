#!/bin/bash

# AgentHub Infrastructure - Service Status
# Usage: ./scripts/status

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

cd "$PROJECT_ROOT"

echo -e "${BLUE}AgentHub Service Status${NC}"
echo ""
docker compose ps

echo ""
echo -e "${BLUE}Resource Usage${NC}"
echo ""
docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}" $(docker compose ps -q 2>/dev/null || echo "")
